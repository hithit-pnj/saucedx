---
// Fraunces (titres) est une police variable : le paquet « full » porte les axes
// SOFT et opsz dont le système a besoin. Space Grotesk (texte) couvre 300–700.
import '@fontsource-variable/fraunces/full.css';
import '@fontsource-variable/fraunces/full-italic.css';
import '@fontsource-variable/space-grotesk/index.css';
import '../styles/global.css';

import { getEntry } from 'astro:content';
import Entete from '../components/Entete.astro';
import PiedDePage from '../components/PiedDePage.astro';

interface Props {
  titre: string;
  description: string;
  /** Conservé pour les contenus existants : tous les climats partagent la même palette. */
  climat?: 'garance' | 'ambre' | 'prune' | 'vert' | 'bronze' | 'nuit' | 'ardoise';
  noindex?: boolean;
}

const { titre, description, climat = 'garance', noindex = false } = Astro.props;
const reglages = (await getEntry('reglages', 'site'))!.data;

const canonique = new URL(Astro.url.pathname, Astro.site).href;
const nomComplet = [reglages.nom, reglages.nomSecond].filter(Boolean).join(' - ');
const locale = reglages.langue === 'fr' ? 'fr_FR' : 'en_GB';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: nomComplet,
  alternateName: reglages.nomSecond || undefined,
  description: reglages.baseline,
  url: Astro.site?.href,
  email: reglages.email,
  founder: { '@type': 'Person', name: reglages.personne, jobTitle: reglages.signature },
  ...(reglages.ville
    ? {
        areaServed: { '@type': 'City', name: reglages.ville },
        address: {
          '@type': 'PostalAddress',
          addressLocality: reglages.ville,
          addressRegion: reglages.region,
          addressCountry: 'FR',
        },
      }
    : {}),
  sameAs: [reglages.instagramUrl],
};
---

<!doctype html>
<html lang={reglages.langue}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titre}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonique} />
    {noindex && <meta name="robots" content="noindex, follow" />}

    <meta name="theme-color" content="#e8cfe7" />
    <meta name="color-scheme" content="light" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content={locale} />
    <meta property="og:site_name" content={nomComplet} />
    <meta property="og:title" content={titre} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonique} />
    <meta property="og:image" content={new URL('/og.png', Astro.site).href} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <script type="application/ld+json" set:html={JSON.stringify(schema)} is:inline />
  </head>

  <body data-climat={climat}>
    <a class="evitement" href="#contenu">{reglages.libelles.allerAuContenu}</a>

    <Entete />

    <main id="contenu" class="scene">
      <slot />
    </main>

    <PiedDePage />

    <script>
      // Apparition sobre au scroll : rien d'indispensable.
      const blocs = document.querySelectorAll<HTMLElement>('.paraitre');
      const sobre = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      if (!sobre && 'IntersectionObserver' in window) {
        const guetteur = new IntersectionObserver(
          (entrees) => {
            for (const entree of entrees) {
              if (!entree.isIntersecting) continue;
              entree.target.classList.add('paru');
              guetteur.unobserve(entree.target);
            }
          },
          { rootMargin: '0px 0px -12% 0px', threshold: 0.01 },
        );
        blocs.forEach((b) => guetteur.observe(b));
      } else {
        blocs.forEach((b) => b.classList.add('paru'));
      }
    </script>

    <style>
      .scene {
        position: relative;
        isolation: isolate;
      }
    </style>
  </body>
</html>
