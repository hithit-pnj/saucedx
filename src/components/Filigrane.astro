---
/**
 * Le filigrane : une grande lettre par page, dans le hero seulement.
 * L'initiale du titre, en Fraunces, ton sur ton, calée en haut à gauche et
 * rognée par le bord de la section (le hero porte overflow: hidden).
 */
interface Props {
  /** Le texte dont on prend l'initiale — en général la première ligne du titre. */
  texte: string;
}
const { texte } = Astro.props;
const lettre = [...texte.trim()].find((c) => /\p{L}/u.test(c))?.toUpperCase() ?? '';
---

{lettre && <span class="filigrane" aria-hidden="true">{lettre}</span>}
