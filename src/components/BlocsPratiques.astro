---
import Prose from './Prose.astro';

/** Les informations pratiques : une carte blanche par bloc, en grille de deux colonnes. */
interface Props {
  blocs: { titre: string; texte: string }[];
}
const { blocs } = Astro.props;
---

{
  blocs.length > 0 && (
    <dl class="pratique">
      {blocs.map((bloc) => (
        <div class="carte carte--compacte">
          <dt>{bloc.titre}</dt>
          <dd>
            <Prose texte={bloc.texte} />
          </dd>
        </div>
      ))}
    </dl>
  )
}
