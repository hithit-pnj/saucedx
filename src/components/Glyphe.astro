---
/**
 * Le geste graphique unique de chaque offre.
 * Il apparaît deux fois : en filigrane (immense, très pâle) et en sceau (petit, net).
 * Il ne s'explique jamais.
 */
type Nom =
  | 'rayonnement'
  | 'visavis'
  | 'meandre'
  | 'fleche'
  | 'collectif'
  | 'cernes'
  | 'suspension'
  | 'bifurcation'
  | 'marque';

interface Props {
  nom: Nom;
  class?: string;
  epaisseur?: number;
  'aria-hidden'?: boolean;
}

const { nom, class: classe, epaisseur = 6, ...reste } = Astro.props;

const rayons = [
  [148, 100, 192, 100],
  [141.6, 124, 179.7, 146],
  [124, 141.6, 146, 179.7],
  [100, 148, 100, 192],
  [76, 141.6, 54, 179.7],
  [58.4, 124, 20.3, 146],
  [52, 100, 8, 100],
  [58.4, 76, 20.3, 54],
  [76, 58.4, 54, 20.3],
  [100, 52, 100, 8],
  [124, 58.4, 146, 20.3],
  [141.6, 76, 179.7, 54],
];

/** Les cinq voix de l'atelier : un rayon, puis la tête au bout. */
const voix = [
  { x1: 100, y1: 78, x2: 100, y2: 48, cx: 100, cy: 42 },
  { x1: 77, y1: 91, x2: 52, y2: 77, cx: 46, cy: 73 },
  { x1: 123, y1: 91, x2: 148, y2: 77, cx: 154, cy: 73 },
  { x1: 86, y1: 125, x2: 68, y2: 150, cx: 63, cy: 156 },
  { x1: 114, y1: 125, x2: 132, y2: 150, cx: 137, cy: 156 },
];
---

{/* La boîte est carrée par attribut : sans cela, un navigateur qui n'a pas la
    feuille de style dessine un cadre de 300 × 150 et écrase le tracé. */}
<svg
  viewBox="0 0 200 200"
  width="40"
  height="40"
  class={classe}
  fill="none"
  stroke="currentColor"
  stroke-width={epaisseur}
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
  {...reste}
>
  {/* À La Cordée — le rayonnement */}
  {
    nom === 'rayonnement' && (
      <>
        {rayons.map(([x1, y1, x2, y2]) => <line x1={x1} y1={y1} x2={x2} y2={y2} />)}
        <circle cx="100" cy="100" r="4" fill="currentColor" stroke="none" />
      </>
    )
  }

  {/* Entretiens individuels — le vis-à-vis */}
  {
    nom === 'visavis' && (
      <>
        <path d="M78,40 A62,62 0 0 0 78,160" />
        <path d="M122,40 A62,62 0 0 1 122,160" />
        <circle cx="100" cy="100" r="6" fill="currentColor" stroke="none" />
      </>
    )
  }

  {/* Les grands tournants — le méandre */}
  {
    nom === 'meandre' && (
      <>
        <path d="M86,14 C86,62 114,62 114,102 C114,142 86,142 86,188" />
        <circle cx="86" cy="14" r="5" fill="currentColor" stroke="none" />
        <circle cx="86" cy="188" r="5" fill="currentColor" stroke="none" />
      </>
    )
  }

  {/* La permanence — la flèche du temps rompue, et la pause qui lévite au-dessus */}
  {
    nom === 'fleche' && (
      <>
        <line x1="18" y1="118" x2="74" y2="118" />
        <line x1="110" y1="118" x2="168" y2="118" />
        <path d="M154,107 L174,118 L154,129" />
        <line x1="92" y1="62" x2="92" y2="96" />
        <line x1="72" y1="62" x2="112" y2="62" />
      </>
    )
  }

  {/* L'atelier philosophique — le collectif */}
  {
    nom === 'collectif' && (
      <>
        <circle cx="100" cy="104" r="16" />
        {voix.map(({ x1, y1, x2, y2, cx, cy }) => (
          <>
            <line x1={x1} y1={y1} x2={x2} y2={y2} />
            <circle cx={cx} cy={cy} r="7" fill="currentColor" stroke="none" />
          </>
        ))}
      </>
    )
  }

  {/* En résidence — les cernes */}
  {
    nom === 'cernes' && (
      <>
        <circle cx="100" cy="100" r="20" />
        <circle cx="100" cy="100" r="40" />
        <circle cx="100" cy="100" r="60" />
        <circle cx="100" cy="100" r="80" />
        <circle cx="100" cy="100" r="6" fill="currentColor" stroke="none" />
      </>
    )
  }

  {/* Pages annexes : la suspension (mentions légales) */}
  {
    nom === 'suspension' && (
      <>
        <line x1="100" y1="14" x2="100" y2="78" />
        <circle cx="100" cy="100" r="13" />
        <line x1="100" y1="122" x2="100" y2="186" />
      </>
    )
  }

  {/* Pages annexes : la bifurcation (contact) */}
  {
    nom === 'bifurcation' && (
      <>
        <path d="M100,190 L100,110" />
        <path d="M100,110 L58,20" />
        <path d="M100,110 L142,20" />
        <circle cx="100" cy="110" r={epaisseur * 0.7} fill="currentColor" stroke="none" />
      </>
    )
  }

  {/* Le Φ de la marque : le fil traversant l'ovale, et les bulles-puits */}
  {
    nom === 'marque' && (
      <>
        <ellipse cx="100" cy="106" rx="54" ry="41" stroke-width={epaisseur} />
        <line x1="100" y1="40" x2="100" y2="180" stroke-width={epaisseur * 1.16} stroke-linecap="round" />
        <circle cx="132" cy="34" r="10" stroke-width={epaisseur * 0.42} />
        <circle cx="153" cy="17" r="6.5" stroke-width={epaisseur * 0.34} opacity="0.7" />
        <circle cx="120" cy="13" r="4" stroke-width={epaisseur * 0.26} opacity="0.5" />
      </>
    )
  }
</svg>
