# La Sauce d'Exister — configuration Apache / LiteSpeed (hébergement mutualisé)

# --- Page 404 dans le ton du site ------------------------------------------
ErrorDocument 404 /404.html

# --- HTTPS et domaine canonique --------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Forcer HTTPS.
  # Le TLS est terminé par un proxy en amont : Apache reçoit alors du HTTP en clair
  # et %{HTTPS} ne vaut jamais « on », même quand le visiteur est bien en HTTPS.
  # Sans les deux conditions suivantes, cette règle se redirige vers elle-même à
  # l'infini et le navigateur affiche « too many redirects ».
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteCond %{HTTP:X-Forwarded-SSL} !=on
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Rediriger www vers le domaine nu, sans écrire le domaine en dur : la règle
  # reste valable quel que soit le nom du site.
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

  # Si vous exploitez un second domaine (un .com par exemple) qui doit renvoyer
  # vers le domaine principal, décommentez les deux lignes suivantes et
  # remplacez « exemple.fr » par votre domaine principal.
  # RewriteCond %{HTTP_HOST} !^exemple\.fr$ [NC]
  # RewriteRule ^ https://exemple.fr%{REQUEST_URI} [L,R=301]

  # --- Mise en maintenance ---------------------------------------------------
  # Interrupteur sans déploiement : déposer un fichier vide nommé « .maintenance »
  # à la racine du site le ferme, le supprimer le rouvre. Effet immédiat.
  #
  # Ce fichier n'est pas dans le dépôt, et le déploiement ne supprime que ce qu'il
  # connaît : la maintenance survit donc aux mises en ligne, y compris déclenchées
  # depuis le CMS. C'est voulu — sinon une modification d'Alice rouvrirait le site
  # sans prévenir.
  #
  # Le code renvoyé est 503 et non 404 : il dit aux moteurs de recherche « repassez
  # plus tard » au lieu de « cette page n'existe plus », ce qui évite un
  # déréférencement pour quelques heures de fermeture.
  #
  # Pour continuer à voir le site pendant la fermeture, décommentez la ligne
  # suivante en y mettant votre adresse IP publique (moteur de recherche : « mon ip »).
  # RewriteCond %{REMOTE_ADDR} !=203.0.113.7
  RewriteCond %{DOCUMENT_ROOT}/.maintenance -f
  RewriteCond %{REQUEST_URI} !^/maintenance\.html$
  RewriteCond %{REQUEST_URI} !^/favicon\.svg$
  RewriteRule ^ - [R=503,L,E=MAINTENANCE:1]
</IfModule>

ErrorDocument 503 /maintenance.html

<IfModule mod_headers.c>
  # Deux lignes pour une seule intention : Apache préfixe les variables d'un
  # « REDIRECT_ » lorsqu'il sert une ErrorDocument, et c'est ce cas-là qui parvient
  # réellement au visiteur.
  Header always set Retry-After "7200" env=MAINTENANCE
  Header always set Retry-After "7200" env=REDIRECT_MAINTENANCE
</IfModule>

# --- Fichiers cachés : hors de portée du web --------------------------------
# Le déploiement dépose son journal de synchronisation, .ftp-deploy-sync-state.json,
# à la racine du dossier publié : il y serait lisible par n'importe qui et donnerait
# l'inventaire complet du site. L'exception .well-known reste indispensable, c'est par
# elle que passe le renouvellement du certificat.
<IfModule mod_rewrite.c>
  RewriteCond %{REQUEST_URI} !^/\.well-known/
  RewriteRule (^|/)\. - [F]

  # Ces fichiers-là ne sont appelés que par les autres scripts : ils ne
  # définissent que des fonctions et ne répondent rien d'utile. Autant ne pas
  # exposer une surface qui n'a pas à l'être.
  RewriteRule ^api/(phpmailer/|courrier\.php|agenda\.php) - [F]
</IfModule>

# --- En-têtes de sécurité ---------------------------------------------------
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), interest-cohort=()"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
</IfModule>

# --- Cache ------------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 hour"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain application/javascript application/json image/svg+xml
</IfModule>

# --- Polices : servies avec le bon type -------------------------------------
<IfModule mod_mime.c>
  AddType font/woff2 .woff2
</IfModule>
