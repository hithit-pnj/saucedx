---
import { getEntry } from 'astro:content';
import Prose from './Prose.astro';

/**
 * L'appel final de chaque page, en Framboise profonde : la seule couleur forte
 * du site, réservée au moment d'agir. Le bouton mène à la page de capture,
 * réglée par Alice dans les réglages du site.
 */
interface Props {
  titre: string;
  texte: string;
  label: string;
}
const { titre, texte, label } = Astro.props;
const { capture } = (await getEntry('reglages', 'site'))!.data;
---

<section class="appel" data-palette="framboise">
  <div class="conteneur pile pile--s paraitre">
    <h2 class="display display--section">{titre}</h2>
    <Prose texte={texte} class="prose--chapeau appel__texte" />
    <a class="bouton" href={capture} rel="noopener">{label}</a>
  </div>
</section>

<style>
  .appel {
    position: relative;
    z-index: 1;
    padding-block: var(--souffle-l);
  }

  .appel .bouton {
    margin-top: 0.75rem;
  }
</style>
