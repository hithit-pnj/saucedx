---
import { getEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Filigrane from '../../components/Filigrane.astro';
import Citation from '../../components/Citation.astro';
import Prose from '../../components/Prose.astro';
import FormulaireContact from '../../components/FormulaireContact.astro';
import PriseDeRendezVous from '../../components/PriseDeRendezVous.astro';

const page = (await getEntry('pages', 'contact'))!;
const reglages = (await getEntry('reglages', 'site'))!.data;
const rendezVous = (await getEntry('rendezVous', 'reglages'))!.data;
const d = page.data.donnees as {
  hero: { lignes: string[]; surtitre: string; citation: string };
  intro: string;
  champs: {
    nom: string;
    email: string;
    message: string;
    consentement: string;
    envoyer: string;
    envoiEnCours: string;
  };
  reponses: { succes: string; erreur: string };
  autrement: { titre: string; texte: string };
};
---

<Base titre={page.data.seo.titre} description={page.data.seo.description} climat={page.data.climat}>
  <article>
    <header class="hero">
      <Filigrane texte={d.hero.lignes[0] ?? ''} />

      <div class="conteneur pile pile--s">
        {d.hero.surtitre && <p class="micro">{d.hero.surtitre}</p>}

        <h1 class="display display--titre">
          {d.hero.lignes.map((ligne, i) => (<>{i > 0 && <br />}{ligne}</>))}
        </h1>

        {d.hero.citation && <Citation texte={d.hero.citation} />}
      </div>
    </header>

    <section class="section section--serree">
      <div class="conteneur pile pile--m">
        <Prose texte={d.intro} class="prose--chapeau" />
        <div class="carte formulaire-carte">
          <FormulaireContact champs={d.champs} reponses={d.reponses} />
        </div>
      </div>
    </section>

    {rendezVous.actif && <PriseDeRendezVous />}

    <section class="section autrement">
      <div class="conteneur pile pile--s">
        <p class="micro">{d.autrement.titre}</p>
        <Prose texte={d.autrement.texte} />
        <ul class="autrement__liens">
          <li><a class="lien" href={`mailto:${reglages.email}`}>{reglages.email}</a></li>
          <li>
            <a class="lien" href={reglages.instagramUrl} rel="me noopener" target="_blank">{reglages.instagram}</a>
          </li>
        </ul>
      </div>
    </section>
  </article>
</Base>

<style>
  .formulaire-carte {
    width: 100%;
    max-width: 44rem;
  }

  .autrement__liens {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.5rem;
  }
</style>
