---
import Base from './Base.astro';
import Filigrane from '../components/Filigrane.astro';
import Citation from '../components/Citation.astro';

/** Une page brève : un mot, une porte de sortie. */
interface Props {
  titre: string;
  description: string;
  climat?: 'garance' | 'ambre' | 'prune' | 'vert' | 'bronze' | 'nuit' | 'ardoise';
  surtitre: string;
  lignes: string[];
  citation?: string;
  noindex?: boolean;
}

const { titre, description, climat = 'garance', surtitre, lignes, citation, noindex = false } = Astro.props;
---

<Base titre={titre} description={description} climat={climat} noindex={noindex}>
  <section class="hero placard">
    <Filigrane texte={lignes[0] ?? surtitre} />

    <div class="conteneur pile pile--s">
      <p class="micro">{surtitre}</p>

      <h1 class="display display--titre">
        {lignes.map((ligne, i) => (<>{i > 0 && <br />}{ligne}</>))}
      </h1>

      {citation && <Citation texte={citation} />}

      <div class="placard__suite pile pile--s">
        <slot />
      </div>
    </div>
  </section>
</Base>

<style>
  .placard {
    padding-bottom: var(--souffle-xl);
  }

  .placard__suite {
    width: 100%;
    margin-top: 0.5rem;
  }

  .placard__suite :global(p) {
    max-width: var(--mesure);
    color: var(--encre);
    line-height: 1.6;
    text-wrap: pretty;
  }

  .placard__suite :global(p a) {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 0.18em;
  }
</style>
