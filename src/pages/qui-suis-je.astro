---
import { getEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import Filigrane from '../components/Filigrane.astro';
import Citation from '../components/Citation.astro';
import Prose from '../components/Prose.astro';
import BlocsPratiques from '../components/BlocsPratiques.astro';
import Appel from '../components/Appel.astro';

const page = (await getEntry('pages', 'qui-suis-je'))!;
const d = page.data.donnees as {
  hero: { lignes: string[]; surtitre: string; citation: string };
  photo: string;
  photoAlt: string;
  photoLegende: string;
  texte: string[];
  reperes: { titre: string; texte: string }[];
  appel: { titre: string; texte: string; label: string };
};
---

<Base titre={page.data.seo.titre} description={page.data.seo.description} climat={page.data.climat}>
  <article>
    <header class="hero">
      <Filigrane texte={d.hero.lignes[0] ?? ''} />

      <div class="conteneur pile pile--s">
        {d.hero.surtitre && <p class="micro">{d.hero.surtitre}</p>}

        <h1 class="display display--titre">
          {d.hero.lignes.map((ligne, i) => (<>{i > 0 && <br />}{ligne}</>))}
        </h1>

        {d.hero.citation && <Citation texte={d.hero.citation} />}
      </div>
    </header>

    <section class="section section--serree">
      <div class:list={['conteneur', 'paraitre', d.photo ? 'grille grille--large' : 'pile']}>
        {
          d.photo && (
            <figure class="portrait">
              <img src={d.photo} alt={d.photoAlt} width="480" height="600" loading="eager" decoding="async" />
              {d.photoLegende && <figcaption class="note">{d.photoLegende}</figcaption>}
            </figure>
          )
        }

        <div class="recit">
          <Prose texte={d.texte} />
        </div>
      </div>
    </section>

    {
      d.reperes.length > 0 && (
        <section class="section">
          <div class="conteneur paraitre">
            <BlocsPratiques blocs={d.reperes} />
          </div>
        </section>
      )
    }

    <Appel titre={d.appel.titre} texte={d.appel.texte} label={d.appel.label} />
  </article>
</Base>

<style>
  .portrait {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .portrait img {
    width: 100%;
    max-width: 24rem;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: var(--rayon);
  }

  .portrait figcaption {
    font-size: 0.875rem;
  }

  .recit {
    width: 100%;
  }
</style>
