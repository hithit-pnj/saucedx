---
import { getEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import Fil from '../components/Fil.astro';
import Glyphe from '../components/Glyphe.astro';
import Filigrane from '../components/Filigrane.astro';
import Citation from '../components/Citation.astro';
import Prose from '../components/Prose.astro';
import BlocsPratiques from '../components/BlocsPratiques.astro';
import Appel from '../components/Appel.astro';

const page = (await getEntry('pages', 'qui-suis-je'))!;
const d = page.data.donnees as {
  hero: { lignes: string[]; surtitre: string; citation: string };
  photo: string;
  photoAlt: string;
  photoLegende: string;
  texte: string[];
  reperes: { titre: string; texte: string }[];
  appel: { titre: string; texte: string; label: string };
};
---

<Base titre={page.data.seo.titre} description={page.data.seo.description} climat={page.data.climat}>
  <article>
    <header class="ouverture">
      <Filigrane nom="marque" />

      <div class="colonne pile pile--centre ouverture__pile">
        <Fil variante="long" />

        <h1 class="display display--titre">
          {d.hero.lignes.map((ligne, i) => (<>{i > 0 && <br />}{ligne}</>))}
        </h1>

        <p class="micro micro--accent">{d.hero.surtitre}</p>

        {
          d.photo && (
            <figure class="portrait">
              <img src={d.photo} alt={d.photoAlt} width="420" height="525" loading="eager" decoding="async" />
              <figcaption class="micro">{d.photoLegende}</figcaption>
            </figure>
          )
        }

        <Fil />

        {d.hero.citation && <Citation texte={d.hero.citation} />}

        <Glyphe nom="marque" class="sceau" />
      </div>
    </header>

    <div class="colonne recit paraitre">
      <Prose texte={d.texte} justifie />
    </div>

    {
      d.reperes.length > 0 && (
        <div class="colonne reperes paraitre">
          <Fil variante="court" />
          <BlocsPratiques blocs={d.reperes} />
        </div>
      )
    }

    <Appel titre={d.appel.titre} texte={d.appel.texte} label={d.appel.label} />
  </article>
</Base>

<style>
  .ouverture {
    position: relative;
    padding-block: clamp(2rem, 6vw, 4rem) var(--souffle-l);
    overflow: hidden;
  }

  .ouverture__pile {
    position: relative;
    z-index: 1;
    gap: clamp(1.25rem, 3vw, 1.75rem);
  }

  .portrait {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.9rem;
    margin-block: 0.75rem;
  }

  .portrait img {
    width: clamp(11rem, 32vw, 15rem);
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    filter: grayscale(1) contrast(1.04);
  }

  .portrait figcaption {
    font-size: 0.5625rem;
    color: var(--encre-4);
  }

  .recit {
    position: relative;
    z-index: 1;
  }

  .reperes {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--souffle-s);
    margin-top: var(--souffle-m);
  }

  .reperes :global(.pratique) {
    width: 100%;
    gap: clamp(1.25rem, 3vw, 1.75rem);
  }
</style>
