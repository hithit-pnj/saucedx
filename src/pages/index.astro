---
import { getEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import Filigrane from '../components/Filigrane.astro';
import Prose from '../components/Prose.astro';
import Portes from '../components/Portes.astro';
import Entreprise from '../components/Entreprise.astro';
import Appel from '../components/Appel.astro';

const page = (await getEntry('pages', 'accueil'))!;
const reglages = (await getEntry('reglages', 'site'))!.data;
const d = page.data.donnees as {
  hero: { lignes: string[]; surtitre: string; lieu: string };
  manifeste: { probleme: string; geste: string; sceau: string };
  entreprise: { surtitre: string; titre: string; colonnes: { offre: string; texte: string }[] };
  portrait: { titre: string; surtitre: string; texte: string; photo: string; photoAlt: string; lien: string };
  appel: { titre: string; texte: string; label: string };
};

/* Les offres montrées dans la section « Two ways in » sortent de la liste des portes. */
const enEntreprise = (d.entreprise?.colonnes ?? []).map((c) => c.offre).filter(Boolean);
---

<Base titre={page.data.seo.titre} description={page.data.seo.description} climat={page.data.climat}>
  {/* 1. L'enseigne, avec la grande lettre en fond. */}
  <section class="hero">
    <Filigrane texte={d.hero.lignes[0] ?? reglages.nom} />

    <div class="conteneur pile pile--s">
      <h1 class="display display--enseigne">
        {d.hero.lignes.map((ligne, i) => (<>{i > 0 && <br />}{ligne}</>))}
      </h1>

      {d.hero.surtitre && <Prose texte={d.hero.surtitre} class="prose--chapeau" />}

      {d.hero.lieu && <p class="note enseigne__note">{d.hero.lieu}</p>}
    </div>
  </section>

  {/* 2. Le manifeste court : le problème nommé, puis le geste en réponse, côte à côte. */}
  <section class="section section--serree">
    <div class="conteneur grille grille--large paraitre">
      <div class="pile pile--xs">
        <Prose texte={d.manifeste.probleme} />
      </div>
      <div class="pile pile--xs">
        <Prose texte={d.manifeste.geste} class="prose--chapeau" />
      </div>
    </div>
  </section>

  {/* 3. Les portes, puis les deux offres présentées côte à côte. */}
  <section class="section">
    <div class="conteneur pile pile--l">
      <div class="pile pile--m paraitre portes-bloc">
        {d.manifeste.sceau && <p class="micro">{d.manifeste.sceau}</p>}
        <Portes exclure={enEntreprise} />
      </div>
      {
        d.entreprise && (
          <div class="paraitre entreprise-zone">
            <Entreprise
              surtitre={d.entreprise.surtitre}
              titre={d.entreprise.titre}
              colonnes={d.entreprise.colonnes}
            />
          </div>
        )
      }
    </div>
  </section>

  {/* 4. Moi, brièvement. */}
  <section class="section section--serree portrait">
    <div class:list={['conteneur', 'paraitre', d.portrait.photo ? 'grille grille--large' : 'pile pile--s']}>
      {
        d.portrait.photo && (
          <img class="portrait__photo" src={d.portrait.photo} alt={d.portrait.photoAlt} width="480" height="600" loading="lazy" decoding="async" />
        )
      }

      <div class="pile pile--s">
        <p class="micro">{d.portrait.surtitre}</p>
        <h2 class="display display--section">{d.portrait.titre}</h2>
        <Prose texte={d.portrait.texte} />
        <a class="lien" href="/qui-suis-je/">{d.portrait.lien}</a>
      </div>
    </div>
  </section>

  {/* 5. L'appel au contact. */}
  <Appel titre={d.appel.titre} texte={d.appel.texte} label={d.appel.label} />

  <p class="pour-lecteurs-decran">{reglages.baseline}</p>
</Base>

<style>
  .enseigne__note {
    margin-top: 0.5rem;
    font-size: 0.875rem;
  }

  .portes-bloc,
  .entreprise-zone {
    width: 100%;
  }

  .portrait__photo {
    width: 100%;
    max-width: 24rem;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: var(--rayon);
  }
</style>
