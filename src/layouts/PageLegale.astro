---
import { getEntry, render } from 'astro:content';
import Base from './Base.astro';
import Filigrane from '../components/Filigrane.astro';

interface Props {
  /** Identifiant du fichier dans src/content/legal, sans extension. */
  entree: string;
}

const { entree } = Astro.props;
const page = (await getEntry('legal', entree))!;
const { Content } = await render(page);
const { libelles } = (await getEntry('reglages', 'site'))!.data;
---

<Base titre={page.data.seo.titre} description={page.data.seo.description} climat="ardoise">
  <article class="legal">
    <header class="hero">
      <Filigrane texte={page.data.titre} />
      <div class="conteneur pile pile--xs">
        <h1 class="display display--titre">{page.data.titre}</h1>
        {page.data.misAJour && <p class="note">{libelles.miseAJour} {page.data.misAJour}</p>}
      </div>
    </header>

    <section class="section section--serree">
      <div class="conteneur legal__corps">
        <Content />
      </div>
    </section>
  </article>
</Base>

<style>
  .legal {
    padding-bottom: var(--souffle-l);
  }

  .legal__corps {
    max-width: var(--mesure);
    line-height: 1.6;
    color: var(--encre);
  }

  .legal__corps :global(h2) {
    margin-top: var(--souffle-m);
    margin-bottom: 0.75rem;
    font-family: var(--display);
    font-weight: 700;
    font-optical-sizing: auto;
    font-variation-settings: 'SOFT' 100;
    font-size: clamp(1.625rem, 2.8vw, 2rem);
    line-height: 1.1;
    color: var(--titre);
    text-wrap: balance;
  }

  .legal__corps :global(p) {
    margin-block: 0 1em;
    text-wrap: pretty;
  }

  .legal__corps :global(ul) {
    margin-block: 0 1em;
    padding-left: 0;
    list-style: none;
  }

  .legal__corps :global(li) {
    position: relative;
    padding-left: 1.875rem;
    margin-bottom: 0.5rem;
  }

  .legal__corps :global(li)::before {
    content: '';
    position: absolute;
    left: 0;
    top: calc(0.8em - 7px);
    width: 14px;
    height: 14px;
    border: 3px solid var(--accent);
    border-radius: 50%;
  }

  .legal__corps :global(strong) {
    font-weight: 600;
    color: var(--titre);
  }

  .legal__corps :global(em) {
    font-style: italic;
  }

  .legal__corps :global(a) {
    color: var(--accent);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.18em;
  }

  .legal__corps :global(a:hover) {
    text-decoration-thickness: 2px;
  }
</style>
