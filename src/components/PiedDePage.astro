---
import { getEntry } from 'astro:content';
import Glyphe from './Glyphe.astro';

/** Le pied de page, en Framboise profonde, aligné à gauche comme le reste. */
const reglages = (await getEntry('reglages', 'site'))!.data;
const { libelles } = reglages;
const nomComplet = [reglages.nom, reglages.nomSecond].filter(Boolean).join(' - ');
---

<footer class="pied" data-palette="framboise">
  <div class="conteneur pied__corps">
    <div class="pied__marque-rang">
      <Glyphe nom="marque" class="pied__marque" epaisseur={6} />
      <p class="micro pied__nom">{nomComplet}</p>
    </div>

    <p class="pied__personne">{reglages.personne}</p>
    <p class="pied__signature">{reglages.signature}</p>

    <ul class="pied__liens">
      <li><a href={`mailto:${reglages.email}`}>{reglages.email}</a></li>
      <li>
        <a href={reglages.instagramUrl} rel="me noopener" target="_blank">{reglages.instagram}</a>
      </li>
    </ul>

    <ul class="pied__legal">
      <li><a href="/mentions-legales/">{libelles.mentionsLegales}</a></li>
      <li><a href="/confidentialite/">{libelles.confidentialite}</a></li>
    </ul>

    {
      reglages.ville && (
        <p class="pied__lieu">{[reglages.ville, reglages.region].filter(Boolean).join(' — ')}</p>
      )
    }
  </div>
</footer>

<style>
  .pied {
    position: relative;
    z-index: 1;
    padding-block: var(--souffle-m) clamp(2.5rem, 6vw, 4rem);
    /* Le pied suit l'appel, de la même couleur : une ligne pâle les distingue. */
    border-top: 1px solid rgb(255 255 255 / 0.16);
  }

  .pied__corps {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.75rem;
  }

  .pied__marque-rang {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.5rem;
  }

  .pied__marque {
    width: 1.5rem;
    height: 1.5rem;
    color: var(--accent);
  }

  .pied__nom {
    color: var(--titre);
  }

  .pied__personne {
    font-weight: 600;
    color: var(--titre);
  }

  .pied__signature {
    max-width: var(--mesure);
    font-size: 0.9375rem;
    color: var(--encre);
  }

  .pied__liens,
  .pied__legal {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.5rem;
  }

  .pied__liens {
    margin-top: 0.75rem;
  }

  .pied__liens a,
  .pied__legal a {
    color: var(--encre);
    text-decoration: underline;
    text-decoration-color: transparent;
    text-underline-offset: 0.25em;
    transition: color 0.25s, text-decoration-color 0.25s;
  }

  .pied__liens a:hover,
  .pied__legal a:hover {
    color: var(--titre);
    text-decoration-color: var(--accent);
  }

  .pied__legal {
    margin-top: 0.25rem;
    font-size: 0.9375rem;
  }

  .pied__lieu {
    margin-top: 0.5rem;
    font-size: 0.875rem;
    color: var(--encre);
  }
</style>
