---
/**
 * Rend un texte brut en paragraphes.
 * Dans le CMS, une ligne vide sépare deux paragraphes ; en YAML « replié »,
 * elle arrive ici sous la forme d'un simple saut de ligne. Tout saut de ligne
 * est donc un changement de paragraphe.
 */
interface Props {
  texte: string | string[];
  class?: string;
}

const { texte, class: classe } = Astro.props;

const paragraphes = (Array.isArray(texte) ? texte : texte.split(/\n+/))
  .map((p) => p.trim())
  .filter(Boolean);
---

{paragraphes.map((p) => <p class:list={['prose', classe]} set:text={p} />)}
