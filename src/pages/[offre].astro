---
import type { GetStaticPaths } from 'astro';
import Base from '../layouts/Base.astro';
import Filigrane from '../components/Filigrane.astro';
import Verbes from '../components/Verbes.astro';
import Citation from '../components/Citation.astro';
import Prose from '../components/Prose.astro';
import BlocsPratiques from '../components/BlocsPratiques.astro';
import Appel from '../components/Appel.astro';
import { offresPubliees } from '../lib/navigation';

export const getStaticPaths = (async () => {
  const offres = await offresPubliees();
  return offres.map((offre) => ({ params: { offre: offre.id }, props: { offre } }));
}) satisfies GetStaticPaths;

const { offre } = Astro.props;
const { hero, sections, cta, seo, climat } = offre.data;
const plusieursFormats = sections.length > 1;
---

<Base titre={seo.titre} description={seo.description} climat={climat}>
  <article>
    <header class="hero">
      <Filigrane texte={hero.lignes[0] ?? offre.data.menu} />

      <div class="conteneur pile pile--s">
        {hero.surtitre && <p class="micro">{hero.surtitre}</p>}

        <h1 class="display display--titre">
          {hero.lignes.map((ligne, i) => (<>{i > 0 && <br />}{ligne}</>))}
        </h1>

        {hero.verbes.length > 0 && <Verbes verbes={hero.verbes} />}

        {hero.citation && <Citation texte={hero.citation} />}

        {hero.mention && <p class="note">{hero.mention}</p>}
      </div>
    </header>

    {
      sections.map((section) => (
        <section class="section format">
          <div class="conteneur pile pile--m paraitre">
            {plusieursFormats && (section.titre || section.sousTitre) && (
              <div class="pile pile--xs">
                {section.sousTitre && <p class="micro">{section.sousTitre}</p>}
                {section.titre && <h2 class="display display--section">{section.titre}</h2>}
              </div>
            )}

            {section.verbes.length > 0 && <Verbes verbes={section.verbes} />}

            {section.texte && <Prose texte={section.texte} class="prose--chapeau" />}

            {section.blocs.length > 0 && <BlocsPratiques blocs={section.blocs} />}
          </div>
        </section>
      ))
    }

    <Appel titre={cta.titre} texte={cta.texte} label={cta.label} />
  </article>
</Base>

<style>
  .format + .format {
    padding-top: 0;
  }
</style>
