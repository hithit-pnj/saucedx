---
import { getEntry } from 'astro:content';
import Enseigne from './Enseigne.astro';
import { menuPrincipal, memeChemin } from '../lib/navigation';

const liens = await menuPrincipal();
const ici = Astro.url.pathname;
const { libelles } = (await getEntry('reglages', 'site'))!.data;
---

<header class="entete">
  <div class="conteneur entete__rang">
    <Enseigne />
    <nav aria-label={libelles.navigation}>
      <button class="bascule" type="button" aria-expanded="false" aria-controls="menu">
        <span class="bascule__mot" data-ouvrir>{libelles.menu}</span>
        <span class="bascule__mot" data-fermer>{libelles.fermer}</span>
      </button>
      <ul class="nav-liens" id="menu">
        {
          liens.map((lien) => (
            <li>
              <a href={lien.href} aria-current={memeChemin(ici, lien.href) ? 'page' : undefined}>
                {lien.libelle}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<style>
  .entete {
    position: relative;
    z-index: 3;
    padding-block: clamp(1.25rem, 3vw, 1.75rem);
    background: var(--fond);
  }

  .entete__rang {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--souffle-s);
    flex-wrap: wrap;
  }

  .bascule {
    display: none;
    padding: 0.5rem 0;
    border: none;
    background: none;
    font-family: var(--texte);
    font-weight: 600;
    font-size: 0.8125rem;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--accent);
    cursor: pointer;
  }

  .bascule__mot[data-fermer] {
    display: none;
  }
  .bascule[aria-expanded='true'] .bascule__mot[data-ouvrir] {
    display: none;
  }
  .bascule[aria-expanded='true'] .bascule__mot[data-fermer] {
    display: inline;
  }

  @media (max-width: 62rem) {
    /* L'enseigne et le bouton restent sur la même ligne ; le menu se déplie dessous. */
    .entete__rang {
      flex-wrap: nowrap;
      align-items: center;
    }
    .bascule {
      display: block;
      flex: none;
    }
    .nav-liens {
      display: none;
      position: absolute;
      left: var(--marge);
      right: var(--marge);
      top: 100%;
      flex-direction: column;
      gap: 0.25rem;
      padding: 0.75rem 1.25rem;
      border-radius: var(--rayon-compact);
      background: var(--carte);
    }
    .nav-liens[data-ouvert] {
      display: flex;
    }
    .nav-liens a {
      display: block;
      padding-block: 0.7rem;
      font-size: 1.0625rem;
      color: var(--carte-encre);
    }
    .nav-liens a:hover,
    .nav-liens a[aria-current='page'] {
      color: var(--carte-accent);
    }
  }
</style>

<script>
  const bascule = document.querySelector<HTMLButtonElement>('.bascule');
  const menu = document.getElementById('menu');
  bascule?.addEventListener('click', () => {
    const ouvert = bascule.getAttribute('aria-expanded') === 'true';
    bascule.setAttribute('aria-expanded', String(!ouvert));
    menu?.toggleAttribute('data-ouvert', !ouvert);
  });
</script>
